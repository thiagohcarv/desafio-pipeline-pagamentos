# Copie para .env e preencha:  cp .env.example .env
# O .env está no .gitignore — NUNCA versione o arquivo preenchido.

# ---------- Confluent Cloud ----------
# Antes do setup, faça login com a SUA conta (usada só em setup/teardown):
#   confluent login --save
CC_CLOUD=aws
CC_REGION=us-east-1
CC_ENV_NAME=desafio-final
CC_CLUSTER_NAME=desafio-basic
CC_POOL_NAME=desafio-pool
CC_POOL_MAX_CFU=5

# ---------- Neon (Postgres de origem) ----------
# Host do endpoint DIRETO (sem "-pooler"): replicação lógica não passa pelo PgBouncer.
NEON_HOST=ep-exemplo-123456.us-east-1.aws.neon.tech
NEON_PORT=5432
NEON_DB=neondb
# Dono do banco: cria tabelas, carrega o seed, cria o cdc_user e a publication.
NEON_OWNER_USER=neondb_owner
NEON_OWNER_PASSWORD=troque-me
# Senha que o setup vai definir para o cdc_user (menor privilégio, usado pelo conector).
CDC_USER_PASSWORD=troque-me-tambem

# ---------- Demo ----------
FRAUD_DEMO_CARD_ID=42
